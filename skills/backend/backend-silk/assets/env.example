# Copy this file to .env and fill in real values. Never commit .env.

# Application
APP_NAME=Backend API

# Logging
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# true writes logs/app.log (rotating, 5 MB x 5); false logs to the console only
LOG_TO_FILE=false

# Database (use the line that matches the project)
# PostgreSQL, FastAPI (async): postgresql+asyncpg://USER:PASSWORD@localhost:5432/DB_NAME
# PostgreSQL, Flask (sync):    postgresql+psycopg://USER:PASSWORD@localhost:5432/DB_NAME
# MongoDB:    mongodb://localhost:27017   (plus MONGODB_DATABASE=...)
DATABASE_URL=

# Auth
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5500
