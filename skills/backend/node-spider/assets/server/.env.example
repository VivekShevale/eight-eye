# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000
APP_NAME=Backend API

# Logging: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
# true also writes logs/app.N.log (rotated at 5 MB, 5 files kept)
LOG_TO_FILE=false

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/app_db
MONGODB_MAX_POOL_SIZE=50

# Auth. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30m

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
